# The dev server proxies /api to the backend (see vite.config.js), so this
# can stay blank in development. In production, if the client and API are
# on different origins (see DEPLOYMENT.md §4), set this to the API's full
# origin, e.g. https://clinic-api.onrender.com — api/client.js prefixes
# every request with it automatically.
VITE_API_URL=
