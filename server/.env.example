# Database
DATABASE_URL="postgresql://user:password@localhost:5432/clinic_dev"

# JWT
JWT_ACCESS_SECRET="replace-with-a-strong-256-bit-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="7"

# Mock payment provider (HMAC secret used to sign/verify the fake webhook)
PAYMENT_WEBHOOK_SECRET="replace-with-a-strong-webhook-secret"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Email (leave blank in dev to just log emails to the console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Clinic Appointments <no-reply@example.com>"
